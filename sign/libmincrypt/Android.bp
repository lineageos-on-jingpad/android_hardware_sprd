cc_library_static {
    name: "libmincrypt",
    srcs: [
        "dsa_sig.c",
        "p256.c",
        "p256_ec.c",
        "p256_ecdsa.c",
        "rsa.c",
        "sha.c",
        "sha256.c",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
    include_dirs: ["hardware/sprd/sign/include"],
    host_supported: true,
}
